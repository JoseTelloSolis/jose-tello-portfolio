---
import { content, person, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <p>© {year} {person.name}. {content[lang].footer.rights}</p>
    <a href="#top-of-page" class="up">{content[lang].ui.top}</a>
  </div>
</footer>

<style>
  footer {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .wrap {
    max-width: 72rem;
    margin-inline: auto;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    font-size: 1rem;
  }
  p {
    color: color-mix(in srgb, var(--color-paper) 75%, transparent);
  }
  .up {
    padding-bottom: 2px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    color: var(--color-paper);
    text-decoration: none;
    background: linear-gradient(var(--color-signal), var(--color-signal)) 0 100% / 0% 2px no-repeat;
    transition: background-size var(--dur-base) var(--ease-out);
  }
  .up:hover {
    background-size: 100% 2px;
  }

  @media (min-width: 768px) {
    .wrap {
      padding-inline: 2rem;
    }
  }
</style>
