---
import Section from './Section.astro';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = content[lang].skills;
const core = new Set(s.core);
// Un grupo sin herramientas no se muestra: no se inventan habilidades
const groups = s.groups.filter((g) => g.items.length > 0);
---

<Section id="skills" title={s.title}>
  <p class="legend meta"><span class="mark" aria-hidden="true"></span>{s.coreNote}</p>

  <!-- Una fila por grupo: el nombre a la izquierda y sus herramientas a la derecha,
       así los grupos de distinta longitud se leen con el mismo ritmo -->
  <div class="rows">
    {
      groups.map((g) => (
        <div class="group">
          <h3>{g.name}</h3>
          <ul>
            {g.items.map((item) => (
              <li class:list={{ core: core.has(item) }}>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .legend {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .mark {
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    background: var(--color-signal);
  }

  .rows {
    border-bottom: 1px solid var(--color-line);
  }
  .group {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.625rem;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.75rem;
    list-style: none;
    padding: 0;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1875rem;
  }
  /* Stack principal: marca de cinta y un peso más */
  li.core {
    font-weight: 600;
  }
  li.core::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    background: var(--color-signal);
  }

  @media (min-width: 768px) {
    .group {
      grid-template-columns: 18rem 1fr;
      gap: 2rem;
      align-items: baseline;
    }
  }
</style>
